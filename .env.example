# Copy to .env, or let `npm run setup` write it for you.

# The folder recordings land in (a Dropbox folder is best). Required.
RECORDINGS_DIR=~/Library/CloudStorage/Dropbox/Plaud Recordings

# Where the web page is served. 127.0.0.1 keeps it on this Mac; see docs/ACCESS.md for your phone.
PORT=8787
HOST=127.0.0.1

# Extra host names the page may be opened under (comma-separated), beyond localhost and *.ts.net.
# ALLOWED_HOSTS=

# Only if `claude` or Python live somewhere unusual.
# CLAUDE_BIN=/path/to/claude
# TRANSCRIBE_PYTHON=/path/to/venv/bin/python
